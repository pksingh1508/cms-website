    "admin": "tsx --env-file=.env.local scripts/admin.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1145.0",
    "@base-ui/react": "^1.8.0",
    "@hookform/resolvers": "^5.9.1",
